<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern Dark Graphite & Charcoal Color Palette -->
    <Color x:Key="ColorBgBase">#0D0F15</Color>
    <Color x:Key="ColorBgCard">#161923</Color>
    <Color x:Key="ColorBgElevated">#1E2230</Color>
    <Color x:Key="ColorBgInput">#12141C</Color>
    <Color x:Key="ColorBgGlass">#D9161923</Color>
    <Color x:Key="ColorBgHover">#282E40</Color>
    <Color x:Key="ColorBorderSubtle">#262B3B</Color>
    <Color x:Key="ColorBorderHighlight">#3D445D</Color>

    <!-- Accents -->
    <Color x:Key="ColorAccent">#8B5CF6</Color>
    <Color x:Key="ColorAccentHover">#9D74FF</Color>
    <Color x:Key="ColorAccentSubtle">#2E224D</Color>
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorDanger">#EF4444</Color>

    <!-- Text -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource ColorBgBase}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}" />
    <SolidColorBrush x:Key="BrushBgGlass" Color="{StaticResource ColorBgGlass}" />
    <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource ColorBgHover}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorBorderHighlight}" />

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentSubtle" Color="{StaticResource ColorAccentSubtle}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <!-- Linear Accent Gradient -->
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
