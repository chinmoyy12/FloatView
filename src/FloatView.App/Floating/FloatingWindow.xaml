<Window x:Class="FloatView.App.Floating.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FloatView"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="480"
        Height="270"
        MinWidth="300"
        MinHeight="180"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Fade-in/out animation for floating media toolbar -->
        <Storyboard x:Key="ShowToolbar">
            <DoubleAnimation Storyboard.TargetName="BottomToolbar" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="HideToolbar">
            <DoubleAnimation Storyboard.TargetName="BottomToolbar" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.3" />
        </Storyboard>
    </Window.Resources>

    <!-- Outer Container with subtle shadow and border -->
    <Border x:Name="OuterBorder"
            Background="{StaticResource BrushBgCard}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5" />
        </Border.Effect>

        <Grid x:Name="RootGrid">
            <!-- Row 0: Custom Draggable Header -->
            <!-- Row 1: Embedded WebView2 and Overlays -->
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Chrome Header -->
            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    Background="{StaticResource BrushBgElevated}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Host Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mini Violet Pill Indicator -->
                        <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtTitle"
                                   Text="FloatView"
                                   Style="{StaticResource StyleBodyText}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   MaxWidth="160"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        
                        <!-- Click-Through Indicator -->
                        <Border x:Name="BadgeClickThrough"
                                Visibility="Collapsed"
                                Background="{StaticResource BrushWarning}"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                ToolTip="Mouse passthrough active. Press Ctrl+Alt+K to disable click-through.">
                            <TextBlock Text="PASSTHROUGH (Ctrl+Alt+K)" FontSize="9" FontWeight="Bold" Foreground="#000000" />
                        </Border>
                    </StackPanel>

                    <!-- Center: Quick URL Bar (compact) -->
                    <Border Grid.Column="1"
                            x:Name="AddressPill"
                            Background="{StaticResource BrushBgInput}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="24"
                            Margin="8,0"
                            Padding="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtUrl"
                                     Text="https://www.youtube.com"
                                     Style="{StaticResource StyleTextBox}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     KeyDown="OnUrlKeyDown" />
                            <Button Grid.Column="1"
                                    x:Name="BtnNavigate"
                                    Style="{StaticResource BtnIcon}"
                                    Width="18"
                                    Height="18"
                                    Padding="2"
                                    ToolTip="Navigate"
                                    Click="OnNavigateClicked">
                                <Path Data="{StaticResource IconArrowForward}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Right: Window Actions (Pin, Preset, Edge Dock, Opacity, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin Topmost -->
                        <Button x:Name="BtnTopmost"
                                Style="{StaticResource BtnIcon}"
                                Width="26"
                                Height="26"
                                Margin="2,0"
                                ToolTip="Toggle Always-On-Top"
                                Click="OnToggleTopmostClicked">
                            <Path x:Name="IconPinPath" Data="{StaticResource IconPin}" Fill="{StaticResource BrushAccent}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>

                        <!-- Click Through Mode -->
                        <Button x:Name="BtnClickThrough"
                                Style="{StaticResource BtnIcon}"
                                Width="26"
                                Height="26"
                                Margin="2,0"
                                ToolTip="Toggle Mouse Click-Through (Ctrl+Alt+K to disable)"
                                Click="OnToggleClickThroughClicked">
                            <Path Data="{StaticResource IconEyeOff}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>

                        <!-- Preset Switcher Button -->
                        <Button x:Name="BtnPreset"
                                Style="{StaticResource BtnIcon}"
                                Width="26"
                                Height="26"
                                Margin="2,0"
                                ToolTip="Cycle Preset (UltraMini, Compact, Cinema)"
                                Click="OnCyclePresetClicked">
                            <Path Data="{StaticResource IconLayers}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>

                        <!-- Edge Dock Toggle -->
                        <Button x:Name="BtnEdgeDock"
                                Style="{StaticResource BtnIcon}"
                                Width="26"
                                Height="26"
                                Margin="2,0"
                                ToolTip="Dock to Right Edge (Auto-Hide)"
                                Click="OnEdgeDockClicked">
                            <Path Data="{StaticResource IconRestore}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnCloseWindow"
                                Style="{StaticResource BtnClose}"
                                Width="26"
                                Height="26"
                                Margin="2,0"
                                ToolTip="Close Float"
                                Click="OnCloseClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 Browser Container -->
            <Grid Grid.Row="1" x:Name="BrowserContainer" Background="#000000">
                <wv2:WebView2 x:Name="WebViewControl" />

                <!-- Loading / Diagnostics Spinner Overlay -->
                <Border x:Name="LoadingOverlay"
                        Background="{StaticResource BrushBgBase}"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading Web Content..." Style="{StaticResource StyleSubHeader}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <ProgressBar IsIndeterminate="True" Width="140" Height="3" Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBgElevated}" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Floating Caption Overlay (at bottom of video) -->
                <Border x:Name="CaptionOverlay"
                        Background="#CC0B0D13"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="16,0,16,48"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        MaxWidth="420"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtCaption"
                               Text=""
                               FontSize="12"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>

                <!-- Bottom Floating Media Control Bar (Reveals on hover) -->
                <Border x:Name="BottomToolbar"
                        Background="{StaticResource BrushBgGlass}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,12,10"
                        Padding="8,4"
                        Height="38"
                        VerticalAlignment="Bottom"
                        Opacity="0.0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Media Playback Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Prev 10s -->
                            <Button Style="{StaticResource BtnIcon}" Width="26" Height="26" Margin="2,0" ToolTip="Rewind 10s" Click="OnRewindClicked">
                                <Path Data="{StaticResource IconPrev}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="11" Height="11" />
                            </Button>

                            <!-- Play / Pause -->
                            <Button x:Name="BtnPlayPause" Style="{StaticResource BtnIcon}" Width="28" Height="28" Margin="2,0" ToolTip="Play / Pause" Click="OnPlayPauseClicked">
                                <Path x:Name="IconPlayPausePath" Data="{StaticResource IconPlay}" Fill="{StaticResource BrushAccent}" Stretch="Uniform" Width="13" Height="13" />
                            </Button>

                            <!-- Forward 10s -->
                            <Button Style="{StaticResource BtnIcon}" Width="26" Height="26" Margin="2,0" ToolTip="Forward 10s" Click="OnForwardClicked">
                                <Path Data="{StaticResource IconNext}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="11" Height="11" />
                            </Button>

                            <!-- Mute Toggle -->
                            <Button x:Name="BtnMute" Style="{StaticResource BtnIcon}" Width="26" Height="26" Margin="2,0" ToolTip="Toggle Mute" Click="OnMuteClicked">
                                <Path x:Name="IconMutePath" Data="{StaticResource IconVolume}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" />
                            </Button>
                        </StackPanel>

                        <!-- Mini Equalizer / Audio Visualizer Bars -->
                        <StackPanel Grid.Column="1"
                                    x:Name="VisualizerPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ToolTip="Audio Reactive Activity">
                            <Border x:Name="Bar0" Width="3" Height="4" Margin="1.5,0" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center" />
                            <Border x:Name="Bar1" Width="3" Height="6" Margin="1.5,0" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center" />
                            <Border x:Name="Bar2" Width="3" Height="12" Margin="1.5,0" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center" />
                            <Border x:Name="Bar3" Width="3" Height="16" Margin="1.5,0" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center" />
                            <Border x:Name="Bar4" Width="3" Height="8" Margin="1.5,0" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center" />
                            <Border x:Name="Bar5" Width="3" Height="4" Margin="1.5,0" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right Actions: Native PiP, Note Capture, Opacity Slider -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Native PiP Button -->
                            <Button Style="{StaticResource BtnIcon}" Width="26" Height="26" Margin="2,0" ToolTip="Pop-out / Native PiP" Click="OnPipClicked">
                                <Path Data="{StaticResource IconPip}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" />
                            </Button>

                            <!-- Add Timestamped Note -->
                            <Button Style="{StaticResource BtnIcon}" Width="26" Height="26" Margin="2,0" ToolTip="Save Note at Current Timestamp" Click="OnAddNoteClicked">
                                <Path Data="{StaticResource IconNote}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" />
                            </Button>

                            <!-- Opacity Slider -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Window Opacity">
                                <Slider x:Name="SliderOpacity"
                                        Style="{StaticResource StyleSlider}"
                                        Width="55"
                                        Minimum="0.25"
                                        Maximum="1.0"
                                        Value="1.0"
                                        ValueChanged="OnOpacitySliderChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
