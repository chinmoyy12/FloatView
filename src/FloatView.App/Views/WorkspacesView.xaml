<UserControl x:Class="FloatView.App.Views.WorkspacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel>

            <!-- Header -->
            <Border Background="{StaticResource BrushBgElevated}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Workspaces &amp; Layout Presets" Style="{StaticResource StyleHeaderMedium}" />
                        <TextBlock Text="Save and restore multi-window desktop configurations with one click." Style="{StaticResource StyleSubHeader}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Save Current Layout Action -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="TxtNewWorkspaceName"
                                 Width="180"
                                 Style="{StaticResource StyleTextBox}"
                                 Text="My Workspace"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <Button x:Name="BtnSaveCurrentLayout"
                                Style="{StaticResource BtnPrimary}"
                                Content="Save Current Layout"
                                Click="OnSaveCurrentLayoutClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspaces Cards -->
            <ItemsControl x:Name="LstWorkspaces">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource StyleHeaderMedium}" Margin="0,0,8,0" />
                                        <Border Background="{StaticResource BrushAccentSubtle}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Windows.Count, StringFormat='{}{0} Windows'}" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource StyleSubHeader}" Margin="0,4,0,0" />

                                    <!-- Window URL Pills -->
                                    <ItemsControl ItemsSource="{Binding Windows}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushBgElevated}" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource StyleCaptionText}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}"
                                            Content="Launch"
                                            Padding="16,8"
                                            Margin="4,0"
                                            Tag="{Binding}"
                                            Click="OnLaunchWorkspaceClicked" />
                                    <Button Style="{StaticResource BtnSecondary}"
                                            Content="Delete"
                                            Padding="10,8"
                                            Margin="4,0"
                                            Tag="{Binding}"
                                            Click="OnDeleteWorkspaceClicked" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
