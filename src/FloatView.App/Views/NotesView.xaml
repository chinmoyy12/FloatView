<UserControl x:Class="FloatView.App.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgElevated}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Floating Captions &amp; Timestamped Notes" Style="{StaticResource StyleHeaderMedium}" />
                    <TextBlock Text="Quickly capture timestamps and video captions while studying or coding." Style="{StaticResource StyleSubHeader}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Search Input -->
                    <TextBox x:Name="TxtSearchNotes"
                             Width="180"
                             Style="{StaticResource StyleTextBox}"
                             Padding="8,6"
                             Margin="4,0"
                             VerticalAlignment="Center"
                             TextChanged="OnSearchNotesChanged" />
                    
                    <Button Style="{StaticResource BtnSecondary}" Margin="4,0" Content="Export to Markdown" Click="OnExportMarkdownClicked" />
                    <Button Style="{StaticResource BtnSecondary}" Margin="4,0" Content="Clear All" Click="OnClearAllClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notes List -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <TextBlock x:Name="TxtNoNotes"
                           Text="No notes captured yet. Click the Note icon in any floating window toolbar to snapshot a timestamp!"
                           Style="{StaticResource StyleCaptionText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="LstNotes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgElevated}"
                                        BorderBrush="{StaticResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="{StaticResource BrushAccentSubtle}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding FormattedTimestamp}" Style="{StaticResource StyleCodeText}" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding ExtractedCaption}" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushTextSecondary}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding NoteText}" Style="{StaticResource StyleBodyText}" Margin="0,2,0,2" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Url}" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Style="{StaticResource BtnIcon}" Margin="2,0" ToolTip="Copy Note" Tag="{Binding}" Click="OnCopyNoteClicked">
                                                <Path Data="{StaticResource IconNote}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" />
                                            </Button>
                                            <Button Style="{StaticResource BtnClose}" Margin="2,0" ToolTip="Delete" Tag="{Binding}" Click="OnDeleteNoteClicked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
