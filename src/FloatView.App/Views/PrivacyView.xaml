<UserControl x:Class="FloatView.App.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel>

            <!-- Privacy Shield Status Card -->
            <Border Background="{StaticResource BrushBgElevated}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Fill="{StaticResource BrushAccent}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Privacy Shield &amp; Request Filter" Style="{StaticResource StyleHeaderLarge}" />
                        </StackPanel>
                        <TextBlock Text="Blocks intrusive ad scripts, tracking telemetry, and analytics before network requests execute."
                                   Style="{StaticResource StyleSubHeader}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Toggle Shield Button -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Background="{StaticResource BrushBgInput}" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Blocked:" Style="{StaticResource StyleCaptionText}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtTotalBlocked" Text="0" Style="{StaticResource StyleCodeText}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnToggleShield"
                                Style="{StaticResource BtnPrimary}"
                                Padding="16,8"
                                Content="Shield Active"
                                Click="OnToggleShieldClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Two-Column Grid: Site Allowlist & Filter Rules -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- Site Allowlist -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Trusted Allowlist" Style="{StaticResource StyleHeaderMedium}" />
                        <TextBlock Text="Websites where Privacy Shield will not intercept requests." Style="{StaticResource StyleCaptionText}" Margin="0,4,0,12" />

                        <!-- Add to allowlist -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewAllowlistHost"
                                     Style="{StaticResource StyleTextBox}"
                                     Padding="8,6"
                                     Text="example.com" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource BtnSecondary}"
                                    Content="Add"
                                    Margin="6,0,0,0"
                                    Padding="12,6"
                                    Click="OnAddAllowlistClicked" />
                        </Grid>

                        <!-- Allowlist Items -->
                        <ListBox x:Name="LstAllowlist"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="260"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgElevated}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" Style="{StaticResource StyleBodyText}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource BtnClose}" Tag="{Binding}" Click="OnRemoveAllowlistClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Filter Rules Management -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Block Rules" Style="{StaticResource StyleHeaderMedium}" />
                            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="Reset to Defaults" Padding="8,4" Click="OnResetRulesClicked" />
                        </Grid>

                        <!-- Add Rule -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewRuleDomain"
                                     Style="{StaticResource StyleTextBox}"
                                     Padding="8,6"
                                     Text="analytics.domain.com" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource BtnSecondary}"
                                    Content="Add Rule"
                                    Margin="6,0,0,0"
                                    Padding="12,6"
                                    Click="OnAddRuleClicked" />
                        </Grid>

                        <!-- Rules Items -->
                        <ListBox x:Name="LstRules"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="260"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgElevated}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Domain}" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding BlockCount, StringFormat='{}Hits: {0}'}" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushAccent}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource BtnSecondary}"
                                                    Content="Toggle"
                                                    Padding="8,3"
                                                    Margin="6,0"
                                                    Tag="{Binding}"
                                                    Click="OnToggleRuleClicked" />
                                            <Button Grid.Column="2" Style="{StaticResource BtnClose}" Tag="{Binding}" Click="OnDeleteRuleClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
