<UserControl x:Class="FloatView.App.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Browser Navigation Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,6"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Style="{StaticResource BtnIcon}" Margin="2,0" ToolTip="Back" Click="OnBackClicked">
                        <Path Data="{StaticResource IconArrowBack}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="12" Height="12" />
                    </Button>
                    <Button x:Name="BtnForward" Style="{StaticResource BtnIcon}" Margin="2,0" ToolTip="Forward" Click="OnForwardClicked">
                        <Path Data="{StaticResource IconArrowForward}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="12" Height="12" />
                    </Button>
                    <Button x:Name="BtnRefresh" Style="{StaticResource BtnIcon}" Margin="2,0" ToolTip="Refresh" Click="OnRefreshClicked">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="12" Height="12" />
                    </Button>
                </StackPanel>

                <!-- Address Bar -->
                <Border Grid.Column="1"
                        Background="{StaticResource BrushBgInput}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="34"
                        Margin="8,0"
                        Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Lock / HTTPS icon -->
                        <Border Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconShield}" Fill="{StaticResource BrushAccent}" Stretch="Uniform" />
                        </Border>

                        <TextBox Grid.Column="1"
                                 x:Name="TxtAddress"
                                 Text="https://www.youtube.com"
                                 Style="{StaticResource StyleTextBox}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 KeyDown="OnAddressKeyDown" />

                        <Button Grid.Column="2"
                                Style="{StaticResource BtnIcon}"
                                Width="24"
                                Height="24"
                                ToolTip="Navigate"
                                Click="OnGoClicked">
                            <Path Data="{StaticResource IconArrowForward}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="10" Height="10" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Tools: Pop-Out to Float & External Browser -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnPopOut"
                            Style="{StaticResource BtnPrimary}"
                            Padding="12,6"
                            Margin="3,0"
                            ToolTip="Open in Floating Window"
                            Click="OnPopOutClicked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPip}" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pop Out" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BtnIcon}" Margin="3,0" ToolTip="Open in Default System Browser" Click="OnOpenExternalClicked">
                        <Path Data="{StaticResource IconExternal}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="13" Height="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Host -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="MainWebView" />

                <!-- Loading overlay -->
                <Border x:Name="WebLoadingOverlay"
                        Background="{StaticResource BrushBgBase}"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Connecting to website..." Style="{StaticResource StyleSubHeader}" Margin="0,0,0,8" />
                        <ProgressBar IsIndeterminate="True" Width="160" Height="3" Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBgElevated}" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
