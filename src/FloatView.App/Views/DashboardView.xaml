<UserControl x:Class="FloatView.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel>

            <!-- Hero Banner -->
            <Border Background="{StaticResource BrushBgElevated}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FLOATVIEW" Style="{StaticResource StyleCodeText}" FontWeight="Bold" Margin="0,0,8,0" />
                            <Border Background="{StaticResource BrushAccentSubtle}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="v1.0 LTS" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Floating Media, Browser &amp; Productivity Utility"
                                   Style="{StaticResource StyleHeaderLarge}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="Stream videos, pin reference docs, dock to screen edges, and organize multi-window workspaces."
                                   Style="{StaticResource StyleSubHeader}" />
                    </StackPanel>

                    <!-- Quick Action -->
                    <Button Grid.Column="1"
                            x:Name="BtnNewFloatHero"
                            Style="{StaticResource BtnPrimary}"
                            VerticalAlignment="Center"
                            Padding="16,10"
                            Click="OnNewFloatClicked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAdd}" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="New Floating Window" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Cards Grid: Active Floats & Focus Mode -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Active Floating Windows & Layout Manager -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Active Floats" Style="{StaticResource StyleHeaderMedium}" Margin="0,0,8,0" />
                                <Border Background="{StaticResource BrushAccentSubtle}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActiveFloatsCount" Text="0 / 3 Active" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushAccent}" FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnToggleVisibility" Style="{StaticResource BtnSecondary}" Margin="3,0" Content="Hide/Show All" Click="OnToggleVisibilityClicked" />
                                <Button x:Name="BtnToggleTopmost" Style="{StaticResource BtnSecondary}" Margin="3,0" Content="Pin/Unpin All" Click="OnToggleTopmostClicked" />
                            </StackPanel>
                        </Grid>

                        <!-- Layout Arrangement Presets -->
                        <Border Background="{StaticResource BrushBgInput}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Layout Presets:" Style="{StaticResource StyleCaptionText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnArrangeSideBySide" Style="{StaticResource BtnSecondary}" Margin="3,0" Content="Side-by-Side" Padding="10,4" Click="OnArrangeSideBySideClicked" />
                                    <Button x:Name="BtnArrangeStacked" Style="{StaticResource BtnSecondary}" Margin="3,0" Content="Stacked" Padding="10,4" Click="OnArrangeStackedClicked" />
                                    <Button x:Name="BtnArrangeGrid" Style="{StaticResource BtnSecondary}" Margin="3,0" Content="3-Window Grid" Padding="10,4" Click="OnArrangeGridClicked" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Active Windows List or Empty State -->
                        <TextBlock x:Name="TxtEmptyState"
                                   Text="No floating windows open. Click 'New Floating Window' or launch a favorite below."
                                   Style="{StaticResource StyleCaptionText}"
                                   Margin="0,10"
                                   HorizontalAlignment="Center" />

                        <ItemsControl x:Name="LstActiveWindows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgElevated}"
                                            BorderBrush="{StaticResource BrushBorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Config.Title}" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Config.Url}" Style="{StaticResource StyleCaptionText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnSecondary}" Margin="2,0" Content="Focus" Padding="8,4" Tag="{Binding}" Click="OnFocusWindowClicked" />
                                                <Button Style="{StaticResource BtnSecondary}" Margin="2,0" Content="Close" Padding="8,4" Tag="{Binding}" Click="OnCloseWindowClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right Card: Focus Mode Session Widget -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconClock}" Fill="{StaticResource BrushAccent}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Focus Session" Style="{StaticResource StyleHeaderMedium}" />
                        </StackPanel>

                        <Border Background="{StaticResource BrushBgInput}" CornerRadius="10" Padding="14" HorizontalAlignment="Center" Width="180" Margin="0,0,0,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtFocusTimer"
                                           Text="25:00"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="TxtFocusStatus"
                                           Text="Work Interval (25m)"
                                           Style="{StaticResource StyleCaptionText}"
                                           Foreground="{StaticResource BrushAccent}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button x:Name="BtnFocusToggle" Style="{StaticResource BtnPrimary}" Margin="4,0" Content="Start / Pause" Click="OnFocusToggleClicked" />
                            <Button x:Name="BtnFocusReset" Style="{StaticResource BtnSecondary}" Margin="4,0" Content="Reset" Click="OnFocusResetClicked" />
                        </StackPanel>

                        <TextBlock x:Name="TxtCompletedPomodoros"
                                   Text="Completed sessions today: 0"
                                   Style="{StaticResource StyleCaptionText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Launch Favourites -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource IconStar}" Fill="{StaticResource BrushAccent}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Universal Quick Launch" Style="{StaticResource StyleHeaderMedium}" />
                    </StackPanel>

                    <!-- Favourites Grid -->
                    <UniformGrid Columns="3" x:Name="GridFavorites">
                        <!-- Populated dynamically in code-behind -->
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
