<Window x:Class="FloatView.App.Palette.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="580"
        Height="380"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="{StaticResource BrushBgCard}"
            BorderBrush="{StaticResource BrushBorderHighlight}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Input Box -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Data="{StaticResource IconSearch}"
                      Fill="{StaticResource BrushAccent}"
                      Stretch="Uniform"
                      Width="16"
                      Height="16"
                      Margin="6,0,10,0"
                      VerticalAlignment="Center" />

                <TextBox Grid.Column="1"
                         x:Name="TxtSearch"
                         Style="{StaticResource StyleTextBox}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="15"
                         Padding="0"
                         VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchKeyDown" />

                <Border Grid.Column="2"
                        Background="{StaticResource BrushBgElevated}"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="ESC to close" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                </Border>
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="1" Background="{StaticResource BrushBorderSubtle}" />

            <!-- Command Results List -->
            <ListBox Grid.Row="2"
                     x:Name="LstCommands"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,8,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     MouseDoubleClick="OnListMouseDoubleClick"
                     KeyDown="OnListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BrushBgHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                            <Setter TargetName="itemBorder" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource StyleCaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource BrushBgElevated}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Hint -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="4,0">
                <TextBlock Text="Navigate with ↑ ↓ • Press Enter to select • Type URL to float directly"
                           Style="{StaticResource StyleCaptionText}"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
