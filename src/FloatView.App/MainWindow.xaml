<Window x:Class="FloatView.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FloatView.App.Views"
        Title="FloatView — Media &amp; Productivity Workspace"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1040"
        Height="680"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <!-- Main Outer Window Border with Rounded Corners and Drop Shadow -->
    <Border Background="{StaticResource BrushBgBase}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Window Header / Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushBgElevated}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource BrushAccentGradient}">
                            <Path Data="{StaticResource IconPip}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="FLOATVIEW" Style="{StaticResource StyleCodeText}" FontWeight="Bold" FontSize="13" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BrushAccentSubtle}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="WORKSPACE" Style="{StaticResource StyleCaptionText}" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <!-- Center: Quick Command Palette Trigger Button -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BtnSecondary}"
                            Height="28"
                            Padding="12,4"
                            ToolTip="Open Command Palette (Alt + Space)"
                            Click="OnCommandPaletteClicked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Quick Actions &amp; Favourites..." Style="{StaticResource StyleCaptionText}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource BrushBgElevated}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                <TextBlock Text="Alt + Space" Style="{StaticResource StyleCodeText}" FontSize="9" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Right: Window Min / Max / Close Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnIcon}" Width="28" Height="28" Margin="2,0" ToolTip="Minimize" Click="OnMinimizeClicked">
                            <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="10" Height="2" />
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Width="28" Height="28" Margin="2,0" ToolTip="Maximize / Restore" Click="OnMaximizeClicked">
                            <Path Data="{StaticResource IconMaximize}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="10" Height="10" />
                        </Button>
                        <Button Style="{StaticResource BtnClose}" Width="28" Height="28" Margin="2,0" ToolTip="Close" Click="OnCloseClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Body: Navigation Rail + View Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Rail -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nav Items -->
                        <StackPanel Grid.Row="0">
                            <!-- Nav: Dashboard -->
                            <RadioButton x:Name="NavDashboard"
                                         GroupName="NavGroup"
                                         IsChecked="True"
                                         Margin="0,0,0,4"
                                         Checked="OnNavChanged">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="navBorder" Background="Transparent" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconLayers}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Dashboard" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushBgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                <Setter TargetName="navBorder" Property="BorderThickness" Value="1,0,0,0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Nav: Embedded Browser -->
                            <RadioButton x:Name="NavBrowser"
                                         GroupName="NavGroup"
                                         Margin="0,0,0,4"
                                         Checked="OnNavChanged">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="navBorder" Background="Transparent" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconExternal}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Web Browser" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushBgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                <Setter TargetName="navBorder" Property="BorderThickness" Value="1,0,0,0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Nav: Workspaces -->
                            <RadioButton x:Name="NavWorkspaces"
                                         GroupName="NavGroup"
                                         Margin="0,0,0,4"
                                         Checked="OnNavChanged">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="navBorder" Background="Transparent" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconRestore}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Workspaces" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushBgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                <Setter TargetName="navBorder" Property="BorderThickness" Value="1,0,0,0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Nav: Notes & Captions -->
                            <RadioButton x:Name="NavNotes"
                                         GroupName="NavGroup"
                                         Margin="0,0,0,4"
                                         Checked="OnNavChanged">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="navBorder" Background="Transparent" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconNote}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Captions &amp; Notes" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushBgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                <Setter TargetName="navBorder" Property="BorderThickness" Value="1,0,0,0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Nav: Privacy Shield -->
                            <RadioButton x:Name="NavPrivacy"
                                         GroupName="NavGroup"
                                         Margin="0,0,0,4"
                                         Checked="OnNavChanged">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="navBorder" Background="Transparent" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconShield}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Privacy Shield" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushBgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                <Setter TargetName="navBorder" Property="BorderThickness" Value="1,0,0,0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Settings Link & Active Floats Pill -->
                        <StackPanel Grid.Row="1">
                            <Border Background="{StaticResource BrushBgInput}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active Floats:" Style="{StaticResource StyleCaptionText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="TxtNavFloatsCount" Text="0 Open" Style="{StaticResource StyleCodeText}" FontWeight="Bold" />
                                </Grid>
                            </Border>

                            <RadioButton x:Name="NavSettings"
                                         GroupName="NavGroup"
                                         Checked="OnNavChanged">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="navBorder" Background="Transparent" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconSettings}" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Settings" Style="{StaticResource StyleBodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushBgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                <Setter TargetName="navBorder" Property="BorderThickness" Value="1,0,0,0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Center Workspace Content Host -->
                <Grid Grid.Column="1" Margin="20,18,20,18">
                    <views:DashboardView x:Name="ViewDashboard" Visibility="Visible" />
                    <views:BrowserView x:Name="ViewBrowser" Visibility="Collapsed" />
                    <views:WorkspacesView x:Name="ViewWorkspaces" Visibility="Collapsed" />
                    <views:NotesView x:Name="ViewNotes" Visibility="Collapsed" />
                    <views:PrivacyView x:Name="ViewPrivacy" Visibility="Collapsed" />
                    <views:SettingsView x:Name="ViewSettings" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
