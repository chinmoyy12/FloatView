{
  "manifest_version": 3,
  "name": "FloatView Companion - Smart Media Detection",
  "version": "1.0.0",
  "description": "Seamlessly detects media playback in Chrome/Edge and floats it in FloatView with one click.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
